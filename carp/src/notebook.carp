; Notebook adapter for the shared declarative view runtime.
(load "../../../carpentry-org/carp-compiler/carp-views/carp-views.carp")
(load "git@github.com:carpentry-org/socket@0.2.3")

(def *nb-view-sources* (the (Map String String) {}))
(def *nb-view-memo* (the (Map String (Array Int)) {}))
(def *nb-token* @"")
(def *nb-server-object* 0)

(defmodule NB
  (doc view-source "records verbatim notebook source for a view selector.")
  (defn view-source [selector source]
    (Map.put! &*nb-view-sources* &selector &source))

(def value-mark (String.from-bytes &[(Byte.from-int 1)]))
(defn capture-print [value]
    (IO.println &(String.append &value-mark &(str &value)))))

; --- json emission ------------------------------------------------------

(defmodule NB
  (defn json-escape [s]
    (let-do [out @""]
      (for [i 0 (String.length s)]
        (let [n (Char.to-int (String.char-at s i))]
          (set! out
                (cond
                  (= n 34) (String.append &out "\\\"")
                  (= n 92) (String.append &out "\\\\")
                  (= n 10) (String.append &out "\\n")
                  (= n 9) (String.append &out "\\t")
                  (= n 13) (String.append &out "\\r")
                  (< n 32) (String.append &out " ")
                  (String.append &out
                                 &(String.from-bytes &[(Byte.from-int n)]))))))
      out))

  (hidden b64-alphabet)
  (def b64-alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

  (private b64-at)
  (hidden b64-at)
  (defn b64-at [idx]
    (Byte.from-int (Char.to-int (String.char-at b64-alphabet idx))))

  (doc base64 "standard base64 with padding, for embedding pixel data.")
  (defn base64 [bytes]
    (let-do [out (the (Array Byte) [])
             n (Array.length bytes)
             i 0]
      (while (< i n)
        (let-do [b0 (Byte.to-int @(Array.unsafe-nth bytes i))
                 b1 (if (< (+ i 1) n) (Byte.to-int @(Array.unsafe-nth bytes (+ i 1))) 0)
                 b2 (if (< (+ i 2) n) (Byte.to-int @(Array.unsafe-nth bytes (+ i 2))) 0)
                 triple (+ (* 65536 b0) (+ (* 256 b1) b2))]
          (Array.push-back! &out (b64-at (/ triple 262144)))
          (Array.push-back! &out (b64-at (Int.mod (/ triple 4096) 64)))
          (Array.push-back! &out
                            (if (< (+ i 1) n)
                              (b64-at (Int.mod (/ triple 64) 64))
                              (Byte.from-int 61)))
          (Array.push-back! &out
                            (if (< (+ i 2) n)
                              (b64-at (Int.mod triple 64))
                              (Byte.from-int 61)))
          (set! i (+ i 3))))
      (String.from-bytes &out)))

  (defn object-json [id]
    (let [object (Array.unsafe-nth &*view-objects* id)
          printed (~(ViewObject.print object))]
      (fmt "{\"id\": %d, \"object_type\": \"%s\", \"print_string\": \"%s\", \"reference_count\": %d, \"should_auto_release\": true}"
           id
           &(json-escape (ViewObject.type-name object))
           &(json-escape &(View.slice &printed 0 4096))
           @(Array.unsafe-nth &*view-refs* id))))

  (defn objects-json []
    (let-do [out @"["]
      (for [i 0 (View.object-count)]
        (do
          (when (> i 0) (set! out (String.append &out ", ")))
          (set! out (String.append &out &(object-json i)))))
      (String.append &out "]")))

  (private stamped-source)
  (hidden stamped-source)
  (defn stamped-source [view]
    (match (Map.get-maybe &*nb-view-sources* (ViewSpec.selector view))
      (Maybe.Just s) s
      (Maybe.Nothing) @(ViewSpec.source view)))

  (private spec-head)
  (hidden spec-head)
  (defn spec-head [view-name view transport]
    (fmt "\"viewName\": \"%s\", \"title\": \"%s\", \"priority\": %d, \"dataTransport\": %d, \"methodSelector\": \"%s\", \"source\": \"%s\""
         view-name
         &(json-escape (ViewSpec.title view))
         @(ViewSpec.priority view)
         transport
         &(json-escape (ViewSpec.selector view))
         &(json-escape &(stamped-source view))))

  (private column-specs-json)
  (hidden column-specs-json)
  (defn column-specs-json [columns]
    (let-do [out @"["]
      (for [i 0 (Array.length columns)]
        (do
          (when (> i 0) (set! out (String.append &out ", ")))
          (set! out
                (String.append &out
                               &(fmt "{\"title\": \"%s\", \"cellWidth\": null, \"type\": \"text\", \"spawnsObjects\": false, \"properties\": []}"
                                     &(json-escape (ViewColumn.title (Array.unsafe-nth columns i))))))))
      (String.append &out "]")))

  (private textual-node)
  (hidden textual-node)
  (defn textual-node [text]
    (fmt "{\"valueTypeName\": \"textualValue\", \"itemText\": \"%s\"}"
         &(json-escape text)))

  (defn view-json [view]
    (let [kind (ViewSpec.kind view)]
      (cond
        (String.= kind "empty")
          (fmt "{\"viewName\": \"GtPhlowEmptyViewSpecification\", \"methodSelector\": \"%s\"}"
               &(json-escape (ViewSpec.selector view)))
        (String.= kind "text")
          (fmt "{%s, \"string\": \"%s\"}"
               &(spec-head "GtPhlowTextEditorViewSpecification" view 1)
               &(json-escape &(View.slice &(~(ViewSpec.content view) &0l &(View.request @"" 0 256 6 65536)) 0 65536)))
        (String.= kind "columned")
          (fmt "{%s, \"columnSpecifications\": %s, \"horizontalScrollingEnabled\": null}"
               &(spec-head "GtPhlowColumnedListViewSpecification" view 2)
               &(column-specs-json (ViewSpec.columns view)))
        (String.= kind "tree")
          (fmt "{%s}" &(spec-head "GtPhlowTreeViewSpecification" view 2))
        (String.= kind "bitmap")
          (fmt "{%s, \"bitmap\": {\"width\": %d, \"height\": %d, \"stride\": %d, \"format\": \"RGBA8888\", \"pixels\": \"%s\"}}"
               &(spec-head "GtPhlowBitmapViewSpecification" view 1)
               @(ViewSpec.width view)
               @(ViewSpec.height view)
               (* @(ViewSpec.width view) 4)
               &(base64 (ViewSpec.pixels view)))
        (fmt "{%s}" &(spec-head "GtPhlowListViewSpecification" view 2)))))

  (defn views-json [id]
    (let-do [views (ViewObject.views (Array.unsafe-nth &*view-objects* id))
             out @"["]
      (for [i 0 (Array.length views)]
        (do
          (when (> i 0) (set! out (String.append &out ", ")))
          (set! out (String.append &out &(view-json (Array.unsafe-nth views i))))))
      (String.append &out "]")))

  (doc view-with-selector "the index of the view with the given selector,
or -1.")
  (defn view-with-selector [id selector]
    (let-do [views (ViewObject.views (Array.unsafe-nth &*view-objects* id))
             found -1]
      (for [i 0 (Array.length views)]
        (when (String.= (ViewSpec.selector (Array.unsafe-nth views i)) selector)
          (set! found i)))
      found))

  (doc view-children "the registered child ids of a listing view, computed
once per (object, selector) and memoized.")
  (defn view-child [id selector row]
    (let [key (fmt "%d/%s/%d" id selector row)]
      (match (Map.get-maybe &*nb-view-memo* &key)
        (Maybe.Just ids) @(Array.unsafe-nth &ids 0)
        (Maybe.Nothing)
          (let [child (View.send-item id selector row)]
            (do (Map.put! &*nb-view-memo* &key &[child]) child)))))

  (private node-value-json)
  (hidden node-value-json)
  (defn node-value-json [id view-index i bytes]
    (let [views (ViewObject.views (Array.unsafe-nth &*view-objects* id))
          view (Array.unsafe-nth views view-index)]
      (if (String.= (ViewSpec.kind view) "columned")
        (let-do [columns (ViewSpec.columns view) out @"{\"columnValues\": ["
                 remaining (Int.max 0 (- bytes 24)) c 0]
          (while (and (< c (Array.length columns)) (> remaining 64))
            (let-do [request (View.request @"" 0 1 6 (Int.max 0 (/ (- remaining 64) 6)))
                     text (View.cell &0l view i c &request)
                     clipped (View.slice &text 0 @(ViewRequest.bytes &request))
                     cell (String.append (if (> c 0) ", " "") &(textual-node &clipped))]
              (set! out (String.append &out &cell))
              (set! remaining (- remaining (String.length &cell)))
              (set! c (Int.inc c))))
          (String.append &out "]}"))
        (let [request (View.request @"" 0 1 6 (Int.max 0 (/ (- bytes 64) 6)))
              text (View.cell &0l view i 0 &request)]
          (textual-node &(View.slice &text 0 @(ViewRequest.bytes &request)))))))

  (defn release-object! [id]
    (let-do [prefix (fmt "%d/" id) keys (Map.keys &*nb-view-memo*)]
      (for [i 0 (Array.length &keys)]
        (let [key (Array.unsafe-nth &keys i)]
          (when (String.starts-with? key &prefix)
            (do (match (Map.get-maybe &*nb-view-memo* key)
                  (Maybe.Nothing) ()
                  (Maybe.Just ids)
                    (for [j 0 (Array.length &ids)]
                      (View.drop-ref! @(Array.unsafe-nth &ids j))))
                (Map.remove! &*nb-view-memo* key)))))
      (View.drop-ref! id)))

  (defn items-json [id selector offset count]
    (let [view-index (view-with-selector id selector)]
      (if (< view-index 0) @"[]"
        (let-do [total (let [views (ViewObject.views (Array.unsafe-nth &*view-objects* id))]
                        (~(ViewSpec.count (Array.unsafe-nth views view-index)) &0l))
                 request (View.request @"" offset count 6 65536)
                 end (View.end-index total &request)
                 row @(ViewRequest.offset &request) remaining 65534 out @"["]
          (while (and (< row end) (> remaining 8256))
            (let-do [node-value (node-value-json id view-index row (Int.max 0 (- remaining 8192)))
                     child (view-child id selector row)
                     object (if (View.valid-id? child) (object-json child) @"null")
                     node (fmt "%s{\"nodeId\": %d, \"nodeValue\": %s, \"phlowObject\": %s}"
                       (if (> row offset) ", " "") child &node-value &object)
                     size (String.length &node)]
              (if (> size remaining) (set! remaining 0)
                (do (when (View.valid-id? child) (View.bump-ref! child))
                    (set! out (String.append &out &node))
                    (set! remaining (- remaining size))))
              (set! row (Int.inc row))))
          (String.append &out "]")))))

  (private tree-view-index)
  (hidden tree-view-index)
  (defn tree-view-index [id]
    (let-do [views (ViewObject.views (Array.unsafe-nth &*view-objects* id))
             found -1]
      (for [i 0 (Array.length views)]
        (when (String.= (ViewSpec.kind (Array.unsafe-nth views i)) "tree")
          (set! found i)))
      found))

  (defn children-json [id]
  (let-do [key (fmt "%d/children" id)
           ids (match (Map.get-maybe &*nb-view-memo* &key)
             (Maybe.Just ids) ids
             (Maybe.Nothing)
               (let-do [vi (tree-view-index id)
                        kids (if (< vi 0) (the (Array Int) [])
                          (let [callback (let [views (ViewObject.views (Array.unsafe-nth &*view-objects* id))]
                                           @(ViewSpec.children (Array.unsafe-nth views vi)))]
                            (callback &0l &(View.request @"" 0 256 6 65536))))]
                 (Map.put! &*nb-view-memo* &key &kids)
                 kids))
           out @"[" remaining 65534 i 0
           end (Int.min 256 (Array.length &ids))]
    (while (and (< i end) (> remaining 8256))
      (let [child @(Array.unsafe-nth &ids i)]
        (do
          (when (View.valid-id? child)
            (let [node (fmt "%s{\"nodeId\": %d, \"nodeValue\": %s, \"phlowObject\": %s}"
                         (if (String.= &out "[") "" ", ") child
                         &(textual-node &(~(ViewObject.print (Array.unsafe-nth &*view-objects* child))))
                         &(object-json child))]
              (if (> (String.length &node) remaining) (set! remaining 0)
                (do (View.bump-ref! child)
                    (set! out (String.append &out &node))
                    (set! remaining (- remaining (String.length &node)))))))
          (set! i (Int.inc i)))))
    (String.append &out "]")))
)

; --- http serving -------------------------------------------------------

(defmodule NB
  (def crlf (String.from-bytes &[(Byte.from-int 13) (Byte.from-int 10)]))

  (defn http-response [body]
    (String.concat &[@"HTTP/1.1 200 OK" @&crlf
                     @"Content-Type: application/json" @&crlf
                     @"Content-Length: " (str (String.length body)) @&crlf
                     @"Connection: close" @&crlf
                     @&crlf
                     @body]))

  (private parse-int-or)
  (hidden parse-int-or)
  (defn parse-int-or [s dflt] (Maybe.from (Int.from-string s) dflt))



  (doc route "answers the JSON body for a request.")
  (defn route [verb path]
    (let-do [segments (String.split-by path &[\/])
             parts (the (Array String) [])]
      (for [i 0 (Array.length &segments)]
        (unless (String.empty? (Array.unsafe-nth &segments i))
          (Array.push-back! &parts @(Array.unsafe-nth &segments i))))
      (let [n (Array.length &parts)]
        (cond
          (String.= verb "DELETE")
            (if (and (= n 4)
                     (and (String.= (Array.unsafe-nth &parts 0) "session")
                          (String.= (Array.unsafe-nth &parts 1) &*nb-token*)))
              (let-do [id (parse-int-or (Array.unsafe-nth &parts 3) -1)]
                (when (View.valid-id? id) (release-object! id))
                @"true")
              @"false")
          (and (= n 1) (String.= (Array.unsafe-nth &parts 0) "session"))
            (fmt "\"%s\"" &(json-escape &*nb-token*))
          (and (= n 1) (String.= (Array.unsafe-nth &parts 0) "id"))
            (str *nb-server-object*)
          (and (= n 1) (String.= (Array.unsafe-nth &parts 0) "objects"))
            (objects-json)
          (and (= n 2) (String.= (Array.unsafe-nth &parts 0) "objects"))
            (let [id (parse-int-or (Array.unsafe-nth &parts 1) -1)]
              (if (View.valid-id? id)
                (do (View.bump-ref! id) (object-json id))
                @"{\"error\": \"no such object\"}"))
          (and (= n 3)
               (and (String.= (Array.unsafe-nth &parts 0) "objects")
                    (String.= (Array.unsafe-nth &parts 2) "views")))
            (let [id (parse-int-or (Array.unsafe-nth &parts 1) -1)]
              (if (View.valid-id? id) (views-json id) @"[]"))
          (and (= n 4)
               (and (String.= (Array.unsafe-nth &parts 0) "objects")
                    (String.= (Array.unsafe-nth &parts 2) "views")))
            (let [id (parse-int-or (Array.unsafe-nth &parts 1) -1)
                  view-index (if (View.valid-id? (parse-int-or (Array.unsafe-nth &parts 1) -1))
                               (view-with-selector (parse-int-or (Array.unsafe-nth &parts 1) -1)
                                                   (Array.unsafe-nth &parts 3))
                               -1)]
              (if (and (View.valid-id? id) (>= view-index 0))
                (view-json (Array.unsafe-nth (ViewObject.views (Array.unsafe-nth &*view-objects* id)) view-index))
                @"null"))
          (and (= n 7)
               (String.= (Array.unsafe-nth &parts 0) "objects")
               (String.= (Array.unsafe-nth &parts 2) "views")
               (String.= (Array.unsafe-nth &parts 4) "items"))
            (let [id (parse-int-or (Array.unsafe-nth &parts 1) -1)
                  request (View.request @"" (parse-int-or (Array.unsafe-nth &parts 5) 0)
                                          (parse-int-or (Array.unsafe-nth &parts 6) 256) 6 65536)]
              (if (View.valid-id? id)
                (items-json id (Array.unsafe-nth &parts 3)
                  @(ViewRequest.offset &request) @(ViewRequest.count &request)) @"[]"))
          (and (= n 5)
               (String.= (Array.unsafe-nth &parts 0) "objects")
               (String.= (Array.unsafe-nth &parts 2) "views")
               (String.= (Array.unsafe-nth &parts 4) "count"))
            (let [id (parse-int-or (Array.unsafe-nth &parts 1) -1)
                  vi (if (View.valid-id? id) (view-with-selector id (Array.unsafe-nth &parts 3)) -1)]
              (if (< vi 0) @"0"
                (let [views (ViewObject.views (Array.unsafe-nth &*view-objects* id))]
                  (str (~(ViewSpec.count (Array.unsafe-nth views vi)) &0l)))))
          (and (= n 5)
               (and (String.= (Array.unsafe-nth &parts 0) "objects")
                    (and (String.= (Array.unsafe-nth &parts 2) "views")
                         (String.= (Array.unsafe-nth &parts 4) "items"))))
            (let [id (parse-int-or (Array.unsafe-nth &parts 1) -1)]
              (if (View.valid-id? id)
                (items-json id (Array.unsafe-nth &parts 3) 0 256)
                @"[]"))
          (and (= n 6)
               (and (String.= (Array.unsafe-nth &parts 0) "objects")
                    (and (String.= (Array.unsafe-nth &parts 2) "views")
                         (String.= (Array.unsafe-nth &parts 4) "children"))))
            ; the path is comma-joined node ids root->node; children hang off
            ; the last one
            (let-do [segments (String.split-by (Array.unsafe-nth &parts 5) &[\,])
                     parent (if (> (Array.length &segments) 0)
                              (parse-int-or (Array.unsafe-nth &segments
                                                              (- (Array.length &segments) 1))
                                            -1)
                              -1)]
              (if (View.valid-id? parent)
                (children-json parent)
                @"[]"))
          (and (= n 6)
               (and (String.= (Array.unsafe-nth &parts 0) "objects")
                    (and (String.= (Array.unsafe-nth &parts 2) "views")
                         (String.= (Array.unsafe-nth &parts 4) "send"))))
            (let [id (parse-int-or (Array.unsafe-nth &parts 5) -1)]
              (if (View.valid-id? id)
                (do (View.bump-ref! id) (object-json id))
                @"{\"error\": \"no such object\"}"))
          @"{\"error\": \"no such route\"}"))))

  (defn-do serve-conn [stream]
    (let-do [br (TcpStream.buffered stream)]
      (match (BufReader.read-line &br)
        (Result.Error _) ()
        (Result.Success request-line)
          (let-do [tokens (String.words &(String.trim &request-line))
                   verb (if (> (Array.length &tokens) 0)
                          @(Array.unsafe-nth &tokens 0)
                          @"GET")
                   path (if (> (Array.length &tokens) 1)
                          @(Array.unsafe-nth &tokens 1)
                          @"/")
                   draining true]
            (while draining
              (match (BufReader.read-line &br)
                (Result.Error _) (set! draining false)
                (Result.Success line)
                  (when (< (String.length &(String.trim &line)) 1)
                    (set! draining false))))
            (ignore (BufReader.write &br &(http-response &(route &verb &path))))
            (ignore (BufReader.flush &br))))
      (BufReader.delete br)))

  (defn serve [port]
    (match (TcpListener.bind "127.0.0.1" port)
      (Result.Error e)
        (do
          (IO.errorln &(String.append "nb bind failed: " &e))
          (System.exit 17))
      (Result.Success listener)
        (let-do [running true]
          (while running
            (match (TcpListener.accept &listener)
              (Result.Error _) (set! running false)
              (Result.Success stream) (serve-conn stream)))))))

; --- entry point --------------------------------------------------------

(defmodule NB
  (doc capture-and-serve "registers the cell's result value as live object 0
and serves the phlow protocol forever. Wrapped around the last expression by
the carp server; never returns. Port and token come from argv when present.")
  (sig capture-and-serve (Fn [a Int (Ref String)] ()))
  (defn capture-and-serve [value port token]
    (let-do [rport (if (> (StaticArray.length &System.args) 1)
                     (Maybe.from (Int.from-string (StaticArray.unsafe-nth &System.args 1))
                                 port)
                     port)
             rtoken (if (> (StaticArray.length &System.args) 2)
                      @(StaticArray.unsafe-nth &System.args 2)
                      @token)]
      (set! *nb-token* rtoken)
      (ignore (IO.Raw.fflush IO.Raw.stdout))
      (ignore (view-register value))
      (set! *nb-server-object*
            (View.leaf @"CarpValueHost"
                     (fmt "carp value host on port %d" rport)))
      (serve rport))))
