(relative-include "subprocess.h")

(register-type Subprocess [pid Int stdin-fd Int stdout-fd Int])

(doc Subprocess
  "is a child process with its stdin and stdout connected to pipes
   the parent can read from and write to.

## Usage
```
(match (Subprocess.spawn \"cat\" &[])
  (Result.Success p)
    (do
      (Subprocess.write-line &p \"hello\")
      (Subprocess.close-in &p)
      (IO.println &(Subprocess.read-all &p))
      (Subprocess.close p))
  (Result.Error e) (IO.errorln &e))
```")

(defmodule Subprocess
  (private spawn-)
  (hidden spawn-)
  (register spawn- (Fn [&String &(Array String)] Subprocess) "Subprocess_spawn_")

  (private write-string-)
  (hidden write-string-)
  (register write-string- (Fn [&Subprocess &String] Int) "Subprocess_write_MINUS_string_")

  (private write-bytes-)
  (hidden write-bytes-)
  (register write-bytes- (Fn [&Subprocess &(Array Byte)] Int) "Subprocess_write_MINUS_bytes_")

  (private read-chunk-)
  (hidden read-chunk-)
  (register read-chunk- (Fn [&Subprocess Int] String) "Subprocess_read_MINUS_chunk_")

  (private alive-)
  (hidden alive-)
  (register alive- (Fn [&Subprocess] Int) "Subprocess_alive_check_")

  (private close-in-)
  (hidden close-in-)
  (register close-in- (Fn [&Subprocess] ()) "Subprocess_close_MINUS_in_")

  (register close (Fn [Subprocess] ()))
  (register copy (Fn [&Subprocess] Subprocess))
  (implements copy Subprocess.copy)

  (doc spawn "spawns `cmd` with the given `args` (NOT including the
   command itself). Stdin and stdout are connected to pipes.
   Stderr is merged into stdout. Returns `(Result Subprocess String)`.")
  (defn spawn [cmd args]
    (let [s (spawn- cmd args)]
      (if (< @(pid &s) 0)
        (Result.Error (System.error-text))
        (Result.Success s))))

  (doc write "writes `msg` to the child's stdin. Returns bytes written or
   an error (the connection is broken).")
  (defn write [s msg]
    (let [n (write-string- s msg)]
      (if (< n 0)
        (Result.Error (System.error-text))
        (Result.Success n))))

  (doc write-line "writes `line` followed by `\\n` to the child's stdin.")
  (defn write-line [s line]
    (let [combined (String.append line "\n")
          n (write-string- s &combined)]
      (if (< n 0)
        (Result.Error (System.error-text))
        (Result.Success n))))

  (doc close-in "closes the child's stdin (signals EOF). The child process
   itself stays alive until it exits on its own; use `close` to terminate it.")
  (defn close-in [s] (close-in- s))

  (doc alive? "checks whether the child process is still running. Reaps
   it if it has exited.")
  (defn alive? [s] (= 1 (alive- s)))

  (doc read-chunk "reads up to `n` bytes from the child's stdout. Returns
   an empty string on EOF or error.")
  (defn read-chunk [s n] (read-chunk- s n))

  (doc read-until "reads from the child's stdout until `marker` appears in
   the accumulated output. Returns everything read up to and including the
   marker. Returns `(Result.Error \"EOF\")` if the child closes stdout
   before the marker is found.")
  (defn read-until [s marker]
    (let-do [buf @""
             found false
             eof false]
      (while (and (not found) (not eof))
        (let [chunk (read-chunk- s 4096)]
          (if (= 0 (String.length &chunk))
            (set! eof true)
            (do
              (set! buf (String.append &buf &chunk))
              (when (String.contains-string? &buf marker)
                (set! found true))))))
      (if found
        (Result.Success buf)
        (Result.Error @"EOF"))))

  (doc read-all "reads from the child's stdout until EOF.")
  (defn read-all [s]
    (let-do [buf @""
             eof false]
      (while (not eof)
        (let [chunk (read-chunk- s 4096)]
          (if (= 0 (String.length &chunk))
            (set! eof true)
            (set! buf (String.append &buf &chunk)))))
      buf)))
