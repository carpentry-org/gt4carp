; Carp-side bridge for GT integration.
;
; Listens on TCP, drives a child carp REPL via stdin/stdout, and exposes
; introspection commands (expand-1 for now) over length-prefixed JSON:
;
;   request:  <decimal length>\n<json bytes>
;   response: <decimal length>\n<json bytes>
;
; Request shape:   {"id": <int>, "cmd": "expand-1", "form": "<carp source>"}
; Response shape:  {"id": <int>, "ok": "<carp source>"}
;             or:  {"id": <int>, "error": "<message>"}
;
; Usage:   carp -x languagelink.carp -- <port>
;          (port 0 picks an OS-assigned port; it is logged to stderr.)

(load "subprocess.carp")
(load "/Users/veitheller/Documents/Code/Github/carp/archive/socket/socket.carp")
(load "/Users/veitheller/Documents/Code/Github/carp/archive/json/json.carp")

(defmodule LL
  (private parse-int)
  (hidden parse-int)
  (defn-do parse-int [s]
    (let-do [n 0 valid (> (String.length s) 0) zero (Char.to-int \0)]
      (for [i 0 (String.length s)]
        (let [c (String.char-at s i)]
          (if (and (>= c \0) (<= c \9))
            (set! n (+ (* n 10) (- (Char.to-int c) zero)))
            (set! valid false))))
      (if valid (Maybe.Just n) (Maybe.Nothing))))

  (defn read-request [br]
    (match (BufReader.read-line br)
      (Result.Error e) (Result.Error e)
      (Result.Success line)
        (let [trimmed (String.trim &line)]
          (match (parse-int &trimmed)
            (Maybe.Nothing) (Result.Error (String.append "bad length: " &trimmed))
            (Maybe.Just n)
              (match (BufReader.read-n br n)
                (Result.Error e) (Result.Error e)
                (Result.Success bytes) (Result.Success (String.from-bytes &bytes)))))))

  (defn-do write-response [br body]
    (let [header (String.append &(str (String.length body)) "\n")]
      (ignore (BufReader.write br &header)))
    (ignore (BufReader.write br body))
    (BufReader.flush br)))

(defmodule LL
  ; --- child carp interaction -------------------------------------------

  (defn wait-for-prompt [child]
    ; Reads until the REPL prompt appears, signaling it is ready for input.
    ; The banner and prompt may arrive in one chunk or several; we don't
    ; care which.
    (match (Subprocess.read-until child "鲤")
      (Result.Error e) (Result.Error e)
      (Result.Success _) (Result.Success ())))

  (defn extract-result [raw]
    ; raw is the slab between us writing a form and the next REPL prompt.
    ; Format: "...=> <RESULT>\n<ANSI prompt>". We slice between "=> "
    ; and the first newline that follows it.
    (let [marker "=> "
          start (String.index-of-string raw marker)]
      (if (< start 0)
        @raw
        (let [body-start (+ start (String.length marker))
              tail (String.suffix raw body-start)
              nl (String.index-of &tail \newline)]
          (if (< nl 0)
            (String.trim &tail)
            (String.prefix &tail nl))))))

  (defn call-carp [child form-src]
    (match (Subprocess.write-line child form-src)
      (Result.Error e) (Result.Error e)
      (Result.Success _)
        (match (Subprocess.read-until child "鲤")
          (Result.Error e) (Result.Error e)
          (Result.Success raw) (Result.Success (extract-result &raw)))))

  ; --- request handling -------------------------------------------------

  (defn get-str [j k]
    (match (JSON.get j k)
      (Maybe.Just (JSON.Str s)) (Result.Success s)
      _ (Result.Error (String.append "missing or non-string field: " k))))

  (defn get-num [j k]
    (match (JSON.get j k)
      (Maybe.Just (JSON.Num n)) (Result.Success n)
      _ (Result.Error (String.append "missing or non-number field: " k))))

  (defn respond-ok [id ok]
    (Result.unsafe-from-success
      (JSON.str &(JSON.obj [(JSON.entry @"id" (JSON.Num id))
                            (JSON.entry @"ok" (JSON.Str @ok))]))))

  (defn respond-err [id err]
    (Result.unsafe-from-success
      (JSON.str &(JSON.obj [(JSON.entry @"id" (JSON.Num id))
                            (JSON.entry @"error" (JSON.Str @err))]))))

  (defn handle [child req-body]
    (match (JSON.parse req-body)
      (Result.Error _) (respond-err 0.0 "json parse error")
      (Result.Success j)
        (let [id (Result.from-success (get-num &j "id") 0.0)
              cmd (Result.from-success (get-str &j "cmd") @"")]
          (cond
            (= &cmd "expand-1")
              (match (get-str &j "form")
                (Result.Error e) (respond-err id &e)
                (Result.Success form)
                  (let [carp-call (fmt "(expand-1 '%s)" &form)]
                    (match (call-carp child &carp-call)
                      (Result.Error e) (respond-err id &e)
                      (Result.Success out) (respond-ok id &out))))
            (respond-err id &(String.append "unknown cmd: " &cmd)))))))

(defmodule LL
  (defn-do serve-one [child stream]
    (let-do [br (TcpStream.buffered stream)
             keep-running true]
      (while keep-running
        (match (read-request &br)
          (Result.Error _) (set! keep-running false)
          (Result.Success body)
            (let [resp (handle child &body)]
              (match (write-response &br &resp)
                (Result.Error _) (set! keep-running false)
                (Result.Success _) ()))))
      (BufReader.delete br))))

(defn parse-port []
  (let [argc (StaticArray.length &System.args)]
    (if (< argc 2)
      8765
      (Maybe.from (Int.from-string (StaticArray.unsafe-nth &System.args 1)) 8765))))

(defn-do die [stage msg]
  (IO.errorln &(String.append stage msg))
  (System.exit 1))

(defn accept-loop [child listener]
  (let-do [running true]
    (while running
      (match (TcpListener.accept listener)
        (Result.Error _) (set! running false)
        (Result.Success stream) (LL.serve-one child stream)))))

(defn-do run-with-child [child port]
  (match (LL.wait-for-prompt &child)
    (Result.Error e) (die "prompt: " &e)
    (Result.Success _) ())
  (IO.errorln "child carp ready")
  (match (TcpListener.bind "127.0.0.1" port)
    (Result.Error e) (die "bind: " &e)
    (Result.Success listener)
      (do
        (IO.errorln &(String.append "languagelink listening on port "
                                     &(str (TcpListener.local-port &listener))))
        (accept-loop &child &listener)
        (TcpListener.close listener)))
  (Subprocess.close child))

(defn main []
  (let-do [port (parse-port)]
    (IO.errorln "spawning child carp ...")
    (match (Subprocess.spawn "carp" &[])
      (Result.Error e) (die "carp spawn failed: " &e)
      (Result.Success child) (run-with-child child port))))
