					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-09-26T21:49:16.267433+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "7QO6zZ/9Q0OUG6IWnoc1rw=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "{{gtClass:CarpTypeAdornmentStyler}} shows inferred types next to definitions and expressions. They come from the server’s `annotate` command, which runs the compiler’s front half over the cell against the session. {{gtClass:CarpAnnotations}} then renames the solver’s type variables to the letters Carp signatures usually use, because nobody wants to read `t8838`."
			},
