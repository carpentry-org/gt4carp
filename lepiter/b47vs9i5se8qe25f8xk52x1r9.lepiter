				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "{{gtClass:CarpLifetimeHighlightStyler}} shows the lifetime of the binding under the cursor: where it is born, where it is borrowed or copied, and where it moves or dies. It’s the borrow checker, made visible!"
			},
