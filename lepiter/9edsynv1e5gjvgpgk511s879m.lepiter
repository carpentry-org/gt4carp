				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "fyRe7d5zRQG/iMtUZ1t3Uw=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "If any of this sounds like fun to you, [the repository](https://github.com/carpentry-org/gt4carp) is on GitHub, and I’d love to hear from you. See you around!"
			}
