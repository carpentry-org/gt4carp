					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2022-06-11T18:28:15.191912+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "Dv7PRJCdDQCASGWFA8ExpA=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "But more about that in the next section!"
			}
		]
